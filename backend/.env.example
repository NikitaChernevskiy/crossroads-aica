# AI Emotional Partner — Backend Configuration
# Copy to .env and fill in values

# ── Storage ─────────────────────────────────────────────────────────────────
# Set USE_IN_MEMORY=true for local dev without Cosmos DB
USE_IN_MEMORY=true

# Cosmos DB (ignored when USE_IN_MEMORY=true)
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_KEY=<primary-key>
COSMOS_DATABASE=emotional-partner
COSMOS_CONTAINER=states

# ── Key Vault (production) ──────────────────────────────────────────────────
KEYVAULT_URL=https://<vault>.vault.azure.net/

# ── Microsoft Foundry Agent Service ────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-nano
MCP_SERVER_URL=https://<container-app-url>/mcp

# ── Observability (Azure Monitor / Application Insights) ──────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
OTEL_SERVICE_NAME=emopartner-backend
LOG_LEVEL=INFO

# ── Server ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── State freshness ────────────────────────────────────────────────────────
STATE_FRESHNESS_SECONDS=300

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
